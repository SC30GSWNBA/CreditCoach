# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional model overrides (OpenRouter model IDs)
CHAT_MODEL=openai/gpt-5
SMALL_MODEL=openai/gpt-5-mini
FALLBACK_MODEL=openai/gpt-4o
# How long GPT-5 "thinks" before answering: minimal | low | medium | high (default low, for speed)
REASONING_EFFORT=low
# Cap on each reply's tokens, reasoning included (default 16000). Keeps a low-credit key from failing over to FALLBACK_MODEL
# MAX_OUTPUT_TOKENS=16000

# Optional local embedding model (sentence-transformers). If you change it, rebuild the
# vector store: uv run python -m creditcoach.rag.ingest
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Memory and dataset storage: Neon Postgres connection string (Neon console > your project > Connect; keep pooling on).
# Without it, memory falls back to plain files in memory/ and the dataset to data/*.csv. Ask a teammate for the shared one.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Read the dataset from data/*.csv even when DATABASE_URL is set (default: postgres when it is set)
# CREDITCOACH_DATA_BACKEND=files

# Chat UI logins are not set here: each of the 15 dataset users has its own login, stored as a password hash in
# creditcoach/app/logins.json (committed). Passwords are shared privately; change one with scripts/set_login.py.

# Optional local reranker (cross-encoder) used at retrieval time; no rebuild needed if changed.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
