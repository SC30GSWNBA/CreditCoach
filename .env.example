# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional model overrides (OpenRouter model IDs)
CHAT_MODEL=openai/gpt-5
SMALL_MODEL=openai/gpt-5-mini
FALLBACK_MODEL=openai/gpt-4o
# How long GPT-5 "thinks" before answering: minimal | low | medium | high (default low, for speed)
REASONING_EFFORT=low

# Optional local embedding model (sentence-transformers). If you change it, rebuild the
# vector store: uv run python -m creditcoach.rag.ingest
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chat UI logins are not set here: each of the 13 dataset users has its own login, stored as a password hash in
# creditcoach/app/logins.json (committed). Passwords are shared privately; change one with scripts/set_login.py.

# Optional local reranker (cross-encoder) used at retrieval time; no rebuild needed if changed.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
