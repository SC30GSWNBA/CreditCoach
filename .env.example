# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional model overrides (OpenRouter model IDs)
CHAT_MODEL=openai/gpt-5
SMALL_MODEL=openai/gpt-5-mini
FALLBACK_MODEL=openai/gpt-4o
# How long GPT-5 "thinks" before answering: minimal | low | medium | high (default low, for speed)
REASONING_EFFORT=low
# Cap on each reply's tokens, reasoning included (default 16000). Keeps a low-credit key from failing over to FALLBACK_MODEL
# MAX_OUTPUT_TOKENS=16000

# Optional local embedding model (sentence-transformers). If you change it, rebuild the
# vector store: uv run python -m creditcoach.rag.ingest
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Memory and dataset storage: Neon Postgres connection string (Neon console > your project > Connect; keep pooling on).
# Without it, memory falls back to plain files in memory/ and the dataset to data/*.csv. Ask a teammate for the shared one.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Read the dataset from data/*.csv even when DATABASE_URL is set (default: postgres when it is set)
# CREDITCOACH_DATA_BACKEND=files

# Chat UI logins are not set here: people sign up in the app, and each login is stored in Neon as a password hash.

# Sign-up (needs DATABASE_URL). New users are created in Neon; these keep the cost bounded.
# How many people may sign up in total (default 50)
# CREDITCOACH_SIGNUP_MAX=50
# Ask for this code on the sign-up form and refuse anyone without it (default: no code needed)
# CREDITCOACH_INVITE_CODE=
# Questions a signed-up user may ask per week (default 5)
# CREDITCOACH_WEEKLY_QUESTIONS=5
# Signs the sign-in cookie. Blank = a new random secret each start, which signs everyone out on restart.
# CREDITCOACH_SESSION_SECRET=
# Mail account for the optional "email me my login" backup at sign-up. Without it the option isn't shown.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<a Google app password, not your own>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional local reranker (cross-encoder) used at retrieval time; no rebuild needed if changed.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Cache (Task 22). Redis connection string; install Redis locally with: brew install redis && brew services start redis
# Without it the cache lives in the app's own memory and is lost on restart.
# REDIS_URL=redis://localhost:6379/0
# Turn every cache layer off (default on)
# CREDITCOACH_CACHE=off
# Stop the answer cache asking SMALL_MODEL whether a reworded question is the same (default on)
# CREDITCOACH_CACHE_CONFIRM=off
